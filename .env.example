# PostgreSQL initial administrator. Replace both passwords in your local .env.
POSTGRES_DB=editorial_lab
POSTGRES_USER=editorial_admin
POSTGRES_PASSWORD=replace_with_long_admin_password
POSTGRES_PORT=5432

# Restricted account used by the Spring application.
APP_DB_USER=editorial_app
APP_DB_PASSWORD=replace_with_long_app_password

# These three values are set in the IntelliJ Run Configuration, not committed.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/editorial_lab
SPRING_DATASOURCE_USERNAME=editorial_app
SPRING_DATASOURCE_PASSWORD=replace_with_long_app_password
